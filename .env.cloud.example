# Copy to .env.cloud (gitignored) for Cloud Run deploy & Qdrant Cloud ingestion
PROJECT_ID=your-gcp-project-id
RUNTIME_SA=linkedin-saved-rag@your-gcp-project-id.iam.gserviceaccount.com
CLOUD_QDRANT_URL=https://YOUR-CLUSTER.qdrant.io:6333
# Only needed locally for `make ingest-cloud`; Cloud Run reads it from Secret Manager (qdrant-api-key:latest)
QDRANT_API_KEY=
